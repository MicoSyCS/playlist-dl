# --- Playlist metadata source -------------------------------------------------
#   auto  (default) - no credentials: keyless public embed player (max 100 tracks)
#                     credentials set: Web API, falling back to the embed player when a
#                     development-mode app is refused a playlist's tracks
#   embed           - always keyless
#   api             - always the Web API (credentials required)
SPOTIFY_METADATA_SOURCE=auto

# --- Spotify Web API (OPTIONAL; server-side only, never exposed to the browser) --
# Only needed for playlists over 100 tracks or album names in the ID3 tags.
# Create an app at https://developer.spotify.com/dashboard and copy its credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Market used for track relinking/availability.
SPOTIFY_MARKET=US

# --- Limits -----------------------------------------------------------------
MAX_PLAYLIST_TRACKS=100
MP3_BITRATE=192
MAX_CONCURRENT_JOBS=2
# Jobs allowed to wait beyond the running ones before new submissions are refused.
MAX_QUEUED_JOBS=10
# Tracks processed in parallel inside one job (keep low: CPU, bandwidth, source rate limits).
TRACK_CONCURRENCY=2
TRACK_TIMEOUT_SECONDS=240
JOB_TIMEOUT_MINUTES=90
# Finished archives (and their job records) are deleted after this many hours.
JOB_EXPIRATION_HOURS=2
CLEANUP_INTERVAL_SECONDS=300
MAX_DOWNLOAD_MB=80

# --- Audio source -------------------------------------------------------------
# Any yt-dlp search prefix: ytsearch (YouTube), scsearch (SoundCloud), ...
SEARCH_PREFIX=ytsearch
SEARCH_RESULTS=6

# --- Runtime ------------------------------------------------------------------
# Where job files live. Must be persistent, writable, and on a disk with room for
# MAX_CONCURRENT_JOBS x MAX_PLAYLIST_TRACKS x ~10 MB.
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
# Comma-separated origins, only needed if the frontend is served from a different origin.
CORS_ORIGINS=
LOG_LEVEL=INFO

# docker compose: host port for the web UI
WEB_PORT=8080
